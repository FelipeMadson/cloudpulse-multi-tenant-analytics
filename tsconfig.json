{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*",
    "backend/src/**/*",
    "tests/**/*",
    "benchmark/**/*",
    "sdk/**/*"
  ],
  "exclude": [
    "frontend/**/*",
    "node_modules/**/*",
    "dist/**/*"
  ]
}
